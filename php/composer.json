{
    "name": "fium/framework",
    "description": "PHP-side package scaffold for the Fium runtime experiment",
    "type": "library",
    "license": "MIT OR Apache-2.0",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Fium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fium\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "stan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
